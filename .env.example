# Copy to `.env` for local overrides. Compose reads this file for variable
# substitution (e.g. HOST_API_PORT). Container DATABASE_URL/REDIS_URL are set
# in docker-compose.yml.

# If host ports are busy, set any of:
# HOST_POSTGRES_PORT=5433
# HOST_REDIS_PORT=6380
# HOST_API_PORT=8001

# SQLAlchemy (sync)
# Match HOST_POSTGRES_PORT (default 5432 in docker-compose).
# HOST_POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg2://fraud:fraud@localhost:5432/fraud_detection

# Use HOST_REDIS_PORT if you changed it (default 6379).
REDIS_URL=redis://localhost:6379/0

# --- Migrations (Alembic) ---
# From project root, with Postgres reachable at DATABASE_URL:
#   alembic upgrade head
#   alembic downgrade -1
# Inside Docker (same compose network as postgres):
#   docker compose run --rm api alembic upgrade head

# Optional trained model bundle (sklearn Pipeline joblib from app.ml.train)
# MODEL_BUNDLE_PATH=app/ml/artifacts/xgboost_v1_bundle.joblib

# Redis list key for async fraud jobs (API LPUSH / worker BRPOP). Same value for api + worker.
# FRAUD_SCORE_QUEUE_KEY=fraud:score:jobs

# Optional
# APP_NAME=fraud-detection-api

# Logging: DEBUG, INFO, WARNING, ERROR (structlog + stdlib).
# LOG_LEVEL=INFO

# --- Robustness / abuse (optional) ---
# Trust X-Forwarded-For only when the API sits behind a trusted reverse proxy.
# TRUST_PROXY_HEADERS=false
# MAX_REQUEST_BODY_BYTES=65536
# API_RATE_LIMIT_PER_MINUTE=300
# FRAUD_POST_RATE_LIMIT_PER_MINUTE=60
# DB_CONNECT_TIMEOUT_SECONDS=10
# DB_POOL_TIMEOUT_SECONDS=30
# REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=5
# REDIS_SOCKET_TIMEOUT_SECONDS=5
